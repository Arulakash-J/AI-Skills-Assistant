# Copy this file to .env and fill in the values. Never commit .env.

# Chat (Google Gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_THINKING_LEVEL=low

# Speech-to-text (Deepgram)
DEEPGRAM_API_KEY=

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Email tool (Gmail SMTP with an app password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# Server
FRONTEND_ORIGIN=http://localhost:5173
LOG_FILE=logs/timing.log
